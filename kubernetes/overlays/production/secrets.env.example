# Copy this file to secrets.env, replace every value, and keep secrets.env out of Git.
# Use URL-safe values for MONGO_APP_PASSWORD or percent-encode it in each MongoDB URL.
WILDDUCK_API_ACCESS_TOKEN=replace-with-at-least-32-random-bytes
WILDDUCK_API_ACCESSCONTROL_SECRET=replace-with-at-least-32-random-bytes
WILDDUCK_LOOP_SECRET=replace-with-at-least-32-random-bytes
WILDDUCK_DKIM_SECRET=replace-with-at-least-32-random-bytes
WILDDUCK_TOTP_SECRET=replace-with-at-least-32-random-bytes
WEBMAIL_SESSION_SECRET=replace-with-at-least-32-random-bytes
WEBMAIL_TOTP_SECRET=replace-with-at-least-32-random-bytes

# Credentials for the bundled single-node MongoDB StatefulSet.
MONGO_ROOT_USERNAME=wildduck-root
MONGO_ROOT_PASSWORD=replace-with-a-long-url-safe-password
MONGO_APP_USERNAME=wildduck
MONGO_APP_PASSWORD=replace-with-a-long-url-safe-password

# These may instead point at externally managed MongoDB and Redis services.
WILDDUCK_MONGO_URL=mongodb://wildduck:replace-with-a-long-url-safe-password@mongo:27017/wildduck?authSource=admin
WEBMAIL_MONGO_URL=mongodb://wildduck:replace-with-a-long-url-safe-password@mongo:27017/wildduck-webmail?authSource=admin
ZONEMTA_MONGO_URL=mongodb://wildduck:replace-with-a-long-url-safe-password@mongo:27017/wildduck?authSource=admin
KIRIN_MONGO_URL=mongodb://wildduck:replace-with-a-long-url-safe-password@mongo:27017/wildduck?authSource=admin
WILDDUCK_REDIS_URL=redis://redis:6379/3
WEBMAIL_REDIS_URL=redis://redis:6379/5
ZONEMTA_REDIS_URL=redis://redis:6379/2
